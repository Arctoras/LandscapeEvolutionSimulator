// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel Simulate
#pragma kernel Generate

#include "Noise.cginc"

#define PI 3.14159265359
#define E 2.71828182846
// 1 Water is 1m^3 of liquid water which weighs ~1000kg
#define WATER_GAS_CONSTANT 461.52 * 1000
#define AIR_GAS_CONSTANT 287.052874

#define AIR_SPECIFIC_HEAT_CAPACITY 1005
#define WATER_VAPOUR_SPECIFIC_HEAT_CAPACITY 1860

// Get neighbours and wrap correctly around (Edge vertices are duplicated, and so need to go 1 further when wrapping)
#define wrapPx(coord) uint2((coord.x + 1) % dim.x, coord.y)
#define wrapNx(coord) uint2((coord.x - 1) % dim.x, coord.y)
#define wrapPy(coord) uint2(coord.x, (coord.y + 1) % dim.y)
#define wrapNy(coord) uint2(coord.x, (coord.y - 1) % dim.y)

uint2 dim;
uint airLayers;
float cellSize;
float doubleCellSize;
float cellSizeSquared;

Texture2DArray<float> input;
RWTexture2DArray<float> result;

// Simulation Parameters:
float c;   // creep speed
float e;   // bedrock erosion speed
float s;   // sedimentation rate
float r;   // rain rate
float m;   // water erosion exponent (water depth multiplier)
float n;   // water erosion exponent (slope multiplier)
float dt;  // timestep

float2 windSpeed;

struct GroundLayer
{
    float h; // Bedrock Height
    float w; // Water Depth
    float s; // Sediment Amount
    
    static GroundLayer sample(uint2 coord)
    {
        GroundLayer states;
        states.h = input[uint3(coord, 0)];
        states.w = input[uint3(coord, 1)];
        states.s = input[uint3(coord, 2)];
        return states;
    }
    
    void applyStep(uint2 coord, float dh, float dw, float ds)
    {
        result[uint3(coord, 0)] = h + dt * dh;
        result[uint3(coord, 1)] = w + dt * dw;
        result[uint3(coord, 2)] = s + dt * ds;
    }
    
    void apply(RWTexture2DArray<float> target, uint2 coord)
    {
        target[uint3(coord, 0)] = h;
        target[uint3(coord, 1)] = w;
        target[uint3(coord, 2)] = s;
    }
    
    float2 flow(float flowRate, float sedimentation)
    {
        // Avoid flowing away sediment that has been deposited
        return flowRate != 0 ? float2(w, s - sedimentation) / flowRate : float2(0, 0);
    }
    
    float getWaterHeight()
    {
        return h + w;
    }
    
    float getWaterCentre()
    {
        // Height of the water's centre of mass
        return h + w / 2;
    }
    
    float4 outFlow(GroundLayer px, GroundLayer nx, GroundLayer py, GroundLayer ny, out float totalOutFlow)
    {
        float waterCentre = getWaterCentre();
        
        float diffPx = px.getWaterCentre() - waterCentre;
        float diffNx = nx.getWaterCentre() - waterCentre;
        float diffPy = py.getWaterCentre() - waterCentre;
        float diffNy = ny.getWaterCentre() - waterCentre;
        
        totalOutFlow = -(min(0, diffPx) + min(0, diffNx) + min(0, diffPy) + min(0, diffNy));
        return float4(diffPx, diffNx, diffPy, diffNy);
    }
    
    float2 totalOutFlow(uint2 coord)
    {
        GroundLayer px = GroundLayer::sample(wrapPx(coord));
        GroundLayer nx = GroundLayer::sample(wrapNx(coord));
        GroundLayer py = GroundLayer::sample(wrapPy(coord));
        GroundLayer ny = GroundLayer::sample(wrapNy(coord));

        float total;
        float4 directionalFlow = outFlow(px, nx, py, ny, total);
        
        float waterSurfaceSlope = length(float2(directionalFlow.x - directionalFlow.y, directionalFlow.z - directionalFlow.w)) / doubleCellSize; // Average gradient across point
        float streamPower = 0;
        if (w > 0 && waterSurfaceSlope > 0) // Compiler can handle fixed pow(0,y) but shader can't handle dynamic pow(x,y) where x = 0
            streamPower = pow(w, m) * pow(waterSurfaceSlope, n);
        
        float sedimentation = streamPower > 0 ? min(s * s / streamPower, s) : s;
        
        return flow(total, sedimentation);
    }
    
    static float2 getFlow(float diff, float2 outFlow, float2 inFlow)
    {
        float landGrad = diff / cellSize;
    
        float2 landFlow = float2(0, 0);
        if (diff > 0)      landFlow = landGrad * inFlow;
        else if (diff < 0) landFlow = landGrad * outFlow;

        return landFlow;
    }
    
    // Calculations requiring knowledge about only the ground layer
    void landCalcs(uint2 coord, out float creep, out float erosion, out float sedimentation, out float waterFlow, out float sedimentFlow)
    {
        GroundLayer px = GroundLayer::sample(wrapPx(coord));
        GroundLayer nx = GroundLayer::sample(wrapNx(coord));
        GroundLayer py = GroundLayer::sample(wrapPy(coord));
        GroundLayer ny = GroundLayer::sample(wrapNy(coord));
    
        float outFlowRate;
        float4 directionalFlow = outFlow(px, nx, py, ny, outFlowRate);
    
        float waterSurfaceSlope = length(float2(directionalFlow.x - directionalFlow.y, directionalFlow.z - directionalFlow.w)) / doubleCellSize; // Average gradient across point
        float streamPower = 0;
        if (w > 0 && waterSurfaceSlope > 0) // Compiler can handle fixed pow(0,y) but shader can't handle dynamic pow(x,y) where x = 0
            streamPower = pow(w, m) * pow(waterSurfaceSlope, n); 
        
        // Deposit sediment before flowing it
        sedimentation = streamPower > 0 ? min(s * s / streamPower, s) : s;
        float2 outFlow = flow(outFlowRate, sedimentation);
        
        // Split water/sediment between each direction of flow weighted by the amount of flow in those directions
        float2 pxOutFlow = px.totalOutFlow(wrapPx(coord));
        float2 nxOutFlow = nx.totalOutFlow(wrapNx(coord));
        float2 pyOutFlow = py.totalOutFlow(wrapPy(coord));
        float2 nyOutFlow = ny.totalOutFlow(wrapNy(coord));
    
        float2 pxFlow = getFlow(directionalFlow.x, outFlow, pxOutFlow);
        float2 nxFlow = getFlow(directionalFlow.y, outFlow, nxOutFlow);
        float2 pyFlow = getFlow(directionalFlow.z, outFlow, pyOutFlow);
        float2 nyFlow = getFlow(directionalFlow.w, outFlow, nyOutFlow);
        
        float2 netFlow = pxFlow + nxFlow + pyFlow + nyFlow; // Positive -> flow in | Negative -> flow out
        
        waterFlow = netFlow.x; 
        sedimentFlow = netFlow.y;
    
        float landHeightLaplacian = (px.h + nx.h + py.h + ny.h - 4 * h) / cellSizeSquared;
        
        erosion = e * streamPower;
        creep = c * landHeightLaplacian;
        
    }
};

struct AirLayer
{
    float a; // Air Amount
    float w; // Water Amount
    float t; // Temperature
    
    float p; // Pressure
    float vp; // Vapour Pressure
    float sp; // Saturation Pressure
    
    void calcPressures(uint2 coord, uint layer, float waterHeight)
    {
        // Air Pressure
        float height = (layer == 0) ? 6000 - waterHeight : 6000;
        float volume = height * cellSizeSquared;
        vp = WATER_GAS_CONSTANT * t * w / volume;
        p = vp + AIR_GAS_CONSTANT * t * a / volume;
        
        // Water Vapour Saturation Pressure
        if (t > 273.15) sp = exp(34.494 - 4924.99 / (t - 36.05)) / pow(t - 168.15, 1.57); // Saturation pressure for above freezing point of water
        else            sp = exp(43.494 - 6545.8 / (t + 4.85)) / pow(t + 594.85, 2);      // Saturation pressure for below freezing point of water
        
        // enhancement factor
        if (t > 273.15) sp *= 1.00071 * exp(0.000000045 * p);
        else            sp *= 0.99882 * exp(0.00000008 * p);
    }
    
    static AirLayer sample(uint2 coord, uint layer)
    {
        AirLayer states;
        states.a = input[uint3(coord.xy, layer * 4 + 3)];
        states.w = input[uint3(coord.xy, layer * 4 + 4)];
        states.t = input[uint3(coord.xy, layer * 4 + 5)];
        states.calcPressures(coord, layer, (input[uint3(coord.xy, 0)] + input[uint3(coord.xy, 1)]));
        return states;
    }
    
    void applyStep(uint2 coord, uint layer, float da, float dw, float dT)
    {
        result[uint3(coord.xy, layer * 4 + 3)] = a + dt * da;
        result[uint3(coord.xy, layer * 4 + 4)] = w + dt * dw;
        result[uint3(coord.xy, layer * 4 + 5)] = t + dt * dT;
        result[uint3(coord.xy, layer * 4 + 6)] = vp / sp;
    }
    
    void apply(RWTexture2DArray<float> target, uint2 coord, uint layer)
    {
        target[uint3(coord.xy, layer * 4 + 3)] = a;
        target[uint3(coord.xy, layer * 4 + 4)] = w;
        target[uint3(coord.xy, layer * 4 + 5)] = t;
        
        calcPressures(coord, layer, (target[uint3(coord.xy, 0)] + target[uint3(coord.xy, 1)]));
        target[uint3(coord.xy, layer * 4 + 6)] = vp / sp;
    }
    
    float getTempChange(float waterAmount)
    {
        if (waterAmount == 0) return 0;
        // 4487.609886 - 0.00006t^3 + 0.050767t^2 - 16.66404605t
        float specificLatentHeat = 4487.609886 - t * (16.66404605 - t * (0.050767 - 0.00006 * t));
        
        return waterAmount * specificLatentHeat / (a * AIR_SPECIFIC_HEAT_CAPACITY + w * WATER_VAPOUR_SPECIFIC_HEAT_CAPACITY);
    }
    
    float calculateEvaporation(float waterDepth)
    {
        float waterVolume = min(0.1, waterDepth) * cellSizeSquared; // Only the surface of water evaporates (10cm deep)
        // Clamp evaporation between 0 and all of the water
        return waterVolume * max(0, min(1, 1 - (vp / sp)));
    }
    
    float getRain()
    {
        return w * max(0, min(1, r * ((vp / sp) - 1)));
    }
    
    float3 flow(float flowRate)
    {
        return flowRate != 0 ? float3(a, w - getRain(), t) / flowRate : float3(0, 0, 0);
    }
    
    float4 outFlow(AirLayer px, AirLayer nx, AirLayer py, AirLayer ny, out float totalOutFlow)
    {
        float diffPx = px.p - p + windSpeed.x;
        float diffNx = nx.p - p - windSpeed.x;
        float diffPy = py.p - p + windSpeed.y;
        float diffNy = ny.p - p - windSpeed.y;
        
        totalOutFlow = -(min(0, diffPx) + min(0, diffNx) + min(0, diffPy) + min(0, diffNy));
        return float4(diffPx, diffNx, diffPy, diffNy);
    }
    
    float3 totalOutFlow(uint2 coord, uint layer)
    {
        AirLayer px = AirLayer::sample(wrapPx(coord), layer);
        AirLayer nx = AirLayer::sample(wrapNx(coord), layer);
        AirLayer py = AirLayer::sample(wrapPy(coord), layer);
        AirLayer ny = AirLayer::sample(wrapNy(coord), layer);

        float total;
        outFlow(px, nx, py, ny, total);
        return flow(total);
    }
    
    static float3 getFlow(float diff, float3 outFlow, float3 inFlow)
    {
        float pressureGrad = abs(diff / cellSize);
    
        float3 airFlow = float3(0, 0, 0);
        if (diff > 0)      airFlow = pressureGrad * inFlow;
        else if (diff < 0) airFlow = pressureGrad * outFlow;

        return airFlow;
    }
    
    void getNetFlow(uint2 coord, uint layer, out float airFlow, out float waterFlow, out float tempFlow)
    {
        AirLayer px = AirLayer::sample(wrapPx(coord), layer);
        AirLayer nx = AirLayer::sample(wrapNx(coord), layer);
        AirLayer py = AirLayer::sample(wrapPy(coord), layer);
        AirLayer ny = AirLayer::sample(wrapNy(coord), layer);
        
        float outFlowRate;
        float4 directionalFlow = outFlow(px, nx, py, ny, outFlowRate);
        float3 outFlow = flow(-outFlowRate);
    
        // Split water/sediment between each direction of flow weighted by the amount of flow in those directions
        float3 pxOutFlow = px.totalOutFlow(wrapPx(coord), layer);
        float3 nxOutFlow = nx.totalOutFlow(wrapNx(coord), layer);
        float3 pyOutFlow = py.totalOutFlow(wrapPy(coord), layer);
        float3 nyOutFlow = ny.totalOutFlow(wrapNy(coord), layer);
    
        float3 pxFlow = getFlow(directionalFlow.x, outFlow, pxOutFlow);
        float3 nxFlow = getFlow(directionalFlow.y, outFlow, nxOutFlow);
        float3 pyFlow = getFlow(directionalFlow.z, outFlow, pyOutFlow);
        float3 nyFlow = getFlow(directionalFlow.w, outFlow, nyOutFlow);
        
        float3 netFlow = pxFlow + nxFlow + pyFlow + nyFlow; // Positive -> flow in | Negative -> flow out
        
        airFlow = netFlow.x;
        waterFlow = netFlow.y;
        tempFlow = netFlow.z;
    }
};


[numthreads(8, 8, 1)]
void Simulate (uint3 id : SV_DispatchThreadID)
{
    uint2 coord = id.xy;
    
    GroundLayer here = GroundLayer::sample(coord);
    float creep, erosion, sedimentation, waterFlow, sedimentFlow;
    here.landCalcs(coord, creep, erosion, sedimentation, waterFlow, sedimentFlow);
    
    // Land Changes
    float dh = creep - erosion + sedimentation; // Change in bedrock height with respect to time
    float dw = waterFlow; // Change in water depth with respect to time
    float ds = sedimentFlow + erosion - sedimentation; // Change in transported sediment with respect to time
    
    here.applyStep(coord, dh, dw, ds);
    
    float waterDepth = result[uint3(coord, 1)];
    
    AirLayer airHere = AirLayer::sample(coord, 0);
        
    float evaporation = airHere.calculateEvaporation(waterDepth);
    float rain = airHere.getRain();
    result[uint3(coord, 1)] += dt * (rain - evaporation) / cellSizeSquared;
    
    float stateChangeTempChange = airHere.getTempChange(rain - evaporation);
    
    float airFlow, waterVapourFlow, tempFlow;
    airHere.getNetFlow(coord, 0, airFlow, waterVapourFlow, tempFlow);
    
    float da = airFlow;
    float dwv = waterVapourFlow + evaporation - rain;
    float dT = tempFlow + stateChangeTempChange;
    
    airHere.applyStep(coord, 0, da, dwv, dT);
}


uint octaves;
float noiseScale;

RWTexture2DArray<float> genResult;
float width;
float height;
float left;
float bottom;
float4 seed;

[numthreads(8, 8, 1)]
void Generate(uint3 id : SV_DispatchThreadID)
{
    float s = id.x / float(dim.x);
    float t = id.y / float(dim.y);
    
    float nx = seed.x + left + cos(s * 2 * PI) * width / (2 * PI);
    float ny = seed.y + bottom + cos(t * 2 * PI) * height / (2 * PI);
    float nz = seed.z + left + sin(s * 2 * PI) * width / (2 * PI);
    float nw = seed.w + bottom + sin(t * 2 * PI) * height / (2 * PI);
    
    float frequency = 1 / noiseScale;
    float scale = 3000;
    
    float sum = 0;
    for (uint octave = 0; octave < octaves; octave++)
    {
        sum += snoise(float4(nx, ny, nz, nw) * frequency) * scale;
        scale *= 0.5;
        frequency *= 2;
    }
    
    GroundLayer ground;
    ground.h = sum;
    ground.w = max(0, -sum);
    ground.s = 0;
    ground.apply(genResult, id.xy);
    
    for (uint layer = 0; layer < airLayers; layer++)
    {
        float height = (layer == 0) ? 6000 - max(0, sum) : 6000;
        float volume = height * cellSizeSquared;
        
        AirLayer air;
        air.a = volume * 1.25;
        air.w = volume / 10000;
        air.t = 288.15; // Starting temperature at 15 degrees Celsius
        air.apply(genResult, id.xy, layer);
    }
}