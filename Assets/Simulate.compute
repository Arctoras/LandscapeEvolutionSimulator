// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel Simulate
#pragma kernel Generate

#include "Noise.cginc"

#define PI 3.14159265359

// Get neighbours and wrap correctly around (Edge vertices are duplicated, and so need to go 1 further when wrapping)
#define wrapPx(coord) uint2((coord.x + 1) % dim.x, coord.y)
#define wrapNx(coord) uint2((coord.x - 1) % dim.x, coord.y)
#define wrapNy(coord) uint2(coord.x, (coord.y + 1) % dim.y)
#define wrapPy(coord) uint2(coord.x, (coord.y - 1) % dim.y)

uint2 dim;
float cellSize;
float doubleCellSize;

Texture3D<float> input;
RWTexture3D<float> result;

// Simulation Parameters:
float u;   // uplift
float c;   // creep speed
float r;   // amount of rain per pixel
float e;   // bedrock erosion speed
float m;   // water erosion exponent (water depth multiplier)
float n;   // water erosion exponent (slope multiplier)
float s;   // sedimentation rate
float dt;  // timestep

float3 sampleLand(uint2 coord)
{
    return float3(input[uint3(coord, 0)], input[uint3(coord, 1)], input[uint3(coord, 2)]);
}

void sampleNeighbours(uint2 coord, out float3 px, out float3 nx, out float3 py, out float3 ny)
{
    px = sampleLand(wrapPx(coord));
    nx = sampleLand(wrapNx(coord));
    py = sampleLand(wrapNy(coord));
    ny = sampleLand(wrapPy(coord));
}


[numthreads(8, 8, 1)]
void Simulate (uint3 id : SV_DispatchThreadID)
{
    uint2 coord = id.xy;
    
    float3 here = sampleLand(coord);
    float3 px;
    float3 nx;
    float3 py;
    float3 ny;
    sampleNeighbours(coord, px, nx, py, ny);
    
    float landHeightLaplacian = (px.x + nx.x + py.x + ny.x - 4 * here.x) / cellSize;
    
    float waterHeight = here.x + here.y;
    float pxWaterHeight = px.x + px.y;
    float nxWaterHeight = nx.x + nx.y;
    float pyWaterHeight = py.x + py.y;
    float nyWaterHeight = ny.x + ny.y;
    float diffPx = pxWaterHeight - waterHeight;
    float diffNx = nxWaterHeight - waterHeight;
    float diffPy = pyWaterHeight - waterHeight;
    float diffNy = nyWaterHeight - waterHeight;
    
    int routesOut = 0;
    float2 pxFlow;
    float3 px2;
    float3 nx2;
    float3 py2;
    float3 ny2;
    if (diffPx > 0)
    {
        sampleNeighbours(wrapPx(coord), px2, nx2, py2, ny2);
        int routesOut2 = 1 + (px2.x + px2.y > pxWaterHeight ? 0 : 1) + (py2.x + py2.y > pxWaterHeight ? 0 : 1) + (ny2.x + ny2.y > pxWaterHeight ? 0 : 1);
        pxFlow = px.yz / routesOut2;
    }
    else
    {
        routesOut++;
    }
    float2 nxFlow;
    if (diffNx > 0)
    {
        sampleNeighbours(wrapNx(coord), px2, nx2, py2, ny2);
        int routesOut2 = 1 + (nx2.x + nx2.y > nxWaterHeight ? 0 : 1) + (py2.x + py2.y > nxWaterHeight ? 0 : 1) + (ny2.x + ny2.y > nxWaterHeight ? 0 : 1);
        nxFlow = nx.yz / routesOut2;
    }
    else
    {
        routesOut++;
    }
    float2 pyFlow;
    if (diffPy > 0)
    {
        sampleNeighbours(wrapPy(coord), px2, nx2, py2, ny2);
        int routesOut2 = 1 + (px2.x + px2.y > pyWaterHeight ? 0 : 1) + (nx2.x + nx2.y > nyWaterHeight ? 0 : 1) + (py2.x + py2.y > pyWaterHeight ? 0 : 1);
        pyFlow = py.yz / routesOut2;
    }
    else
    {
        routesOut++;
    }
    float2 nyFlow;
    if (diffNy > 0)
    {
        sampleNeighbours(wrapNy(coord), px2, nx2, py2, ny2);
        int routesOut2 = 1 + (px2.x + px2.y > nyWaterHeight ? 0 : 1) + (nx2.x + nx2.y > nyWaterHeight ? 0 : 1) + (ny2.x + ny2.y > nyWaterHeight ? 0 : 1);
        nyFlow = ny.yz / routesOut2;
    }
    else
    {
        routesOut++;
    } 
    float2 availableToFlowOut = here.yz / routesOut; // Avoid risk of creating water/sediment for each direction of flow
    
    float waterFlow = (diffPx * (diffPx > 0 ? pxFlow.x : availableToFlowOut.x) + // Positive -> flow in | Negative -> flow out
                       diffNx * (diffNx > 0 ? nxFlow.x : availableToFlowOut.x) +
                       diffPy * (diffPy > 0 ? pyFlow.x : availableToFlowOut.x) +
                       diffNy * (diffNy > 0 ? nyFlow.x : availableToFlowOut.x)) / cellSize;
    float sedimentFlow = (diffPx * (diffPx > 0 ? pxFlow.y : availableToFlowOut.y) + // Positive -> flow in | Negative -> flow out
                          diffNx * (diffNx > 0 ? nxFlow.y : availableToFlowOut.y) +
                          diffPy * (diffPy > 0 ? pyFlow.y : availableToFlowOut.y) +
                          diffNy * (diffNy > 0 ? nyFlow.y : availableToFlowOut.y)) / cellSize;
    
    float waterSurfaceSlope = length(float2(diffPx - diffNx, diffPy - diffNy)) / doubleCellSize; // Average gradient across point
    float streamPower = here.y > 0 && waterSurfaceSlope > 0 ? pow(here.y, m) * pow(waterSurfaceSlope, n) : 0; // Compiler can handle fixed pow(0,y) but shader can't handle dynamic pow(x,y) where x = 0
    
    float erosion = e * streamPower;
    float creep = c * landHeightLaplacian;
    
    float sedimentation = streamPower > 0 ? min(s * min(here.z, here.z + sedimentFlow) / streamPower, here.z + sedimentFlow) : min(here.z, here.z + sedimentFlow); // Sediment flow can be negative and so we need to avoid possibly creating sediment out of nothing
    
    float dw = r + waterFlow; // Change in water depth with respect to time
    float dh = creep - erosion + u + sedimentation; // Change in bedrock height with respect to time
    float dl = sedimentFlow + erosion - sedimentation; // Change in transported sediment with respect to time

    float3 newState = here + dt * float3(dh, dw, dl);
    
    result[uint3(coord, 0)] = newState.x;
    result[uint3(coord, 1)] = max(0, newState.y); // this max should never actually do anything unless something goes wrong
    result[uint3(coord, 2)] = max(0, newState.z);
}


uint octaves;
float noiseScale;

RWTexture3D<float> genResult;
float width;
float height;
float left;
float bottom;
float4 seed;

[numthreads(8, 8, 1)]
void Generate(uint3 id : SV_DispatchThreadID)
{
    float s = id.x / float(dim.x - 1);
    float t = id.y / float(dim.y - 1);
    
    float nx = seed.x + left + cos(s * 2 * PI) * width / (2 * PI);
    float ny = seed.y + bottom + cos(t * 2 * PI) * height / (2 * PI);
    float nz = seed.z + left + sin(s * 2 * PI) * width / (2 * PI);
    float nw = seed.w + bottom + sin(t * 2 * PI) * height / (2 * PI);
    
    float frequency = 1 / noiseScale;
    float scale = 10;
    
    float sum = 0;
    for (uint i = 0; i < octaves; i++)
    {
        sum += snoise(float4(nx, ny, nz, nw) * frequency) * scale;
        scale *= 0.5;
        frequency *= 2;
    }
    
    genResult[uint3(id.xy, 0)] = sum;
    genResult[uint3(id.xy, 1)] = max(0, -sum);
    genResult[uint3(id.xy, 2)] = 0;
}