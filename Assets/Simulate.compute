// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel Simulate
#pragma kernel Generate

#include "Noise.cginc"

#define PI 3.14159265359

// Get neighbours and wrap correctly around (Edge vertices are duplicated, and so need to go 1 further when wrapping)
#define wrapPx(coord) uint2((coord.x + 1) % dim.x, coord.y)
#define wrapNx(coord) uint2((coord.x - 1) % dim.x, coord.y)
#define wrapNy(coord) uint2(coord.x, (coord.y + 1) % dim.y)
#define wrapPy(coord) uint2(coord.x, (coord.y - 1) % dim.y)

uint2 dim;
float cellSize;
float doubleCellSize;

Texture3D<float> input;
RWTexture3D<float> result;

// Simulation Parameters:
float u;   // uplift
float c;   // creep speed
float r;   // amount of rain per pixel
float e;   // bedrock erosion speed
float m;   // water erosion exponent (water depth multiplier)
float n;   // water erosion exponent (slope multiplier)
float s;   // sedimentation rate
float dt;  // timestep

float3 sampleLand(uint2 coord)
{
    return float3(input[uint3(coord, 0)], input[uint3(coord, 1)], input[uint3(coord, 2)]);
}

float getWaterHeight(float3 states)
{
    return states.x + states.y;
}

float sampleInFlow(uint2 coord, uint direction, float waterHeight, float targetWaterHeight)
{
    float px = direction == 1 ? targetWaterHeight : getWaterHeight(sampleLand(wrapPx(coord)));
    float nx = direction == 0 ? targetWaterHeight : getWaterHeight(sampleLand(wrapNx(coord)));
    float py = direction == 3 ? targetWaterHeight : getWaterHeight(sampleLand(wrapPy(coord)));
    float ny = direction == 2 ? targetWaterHeight : getWaterHeight(sampleLand(wrapNy(coord)));
    
    float diffPx = px - waterHeight;
    float diffNx = nx - waterHeight;
    float diffPy = py - waterHeight;
    float diffNy = ny - waterHeight;
    
    return abs((min(0, diffPx) + min(0, diffNx) + min(0, diffPy) + min(0, diffNy)));
}


[numthreads(8, 8, 1)]
void Simulate (uint3 id : SV_DispatchThreadID)
{
    uint2 coord = id.xy;
    
    float3 here = sampleLand(coord);
    float3 px = sampleLand(wrapPx(coord));
    float3 nx = sampleLand(wrapNx(coord));
    float3 py = sampleLand(wrapNy(coord));
    float3 ny = sampleLand(wrapPy(coord));
    
    float waterHeight = here.x + here.y;
    float pxWaterHeight = px.x + px.y;
    float nxWaterHeight = nx.x + nx.y;
    float pyWaterHeight = py.x + py.y;
    float nyWaterHeight = ny.x + ny.y;
    float diffPx = pxWaterHeight - waterHeight;
    float diffNx = nxWaterHeight - waterHeight;
    float diffPy = pyWaterHeight - waterHeight;
    float diffNy = nyWaterHeight - waterHeight;
    
    // Split water/sediment between each direction of flow weighted by the amount of flow in those directions
    float outFlow = min(0, diffPx) + min(0, diffNx) + min(0, diffPy) + min(0, diffNy);
    float2 splitFlow = outFlow != 0 ? here.yz / outFlow : 0;
    float2 pxFlow = float2(0, 0);
    float2 nxFlow = float2(0, 0);
    float2 pyFlow = float2(0, 0);
    float2 nyFlow = float2(0, 0);
    if (diffPx > 0)      pxFlow = diffPx * diffPx * px.yz / sampleInFlow(wrapPx(coord), 0, pxWaterHeight, waterHeight);
    else if (diffPx < 0) pxFlow = diffPx * diffPx * splitFlow;
    if (diffNx > 0)      nxFlow = diffNx * diffNx * nx.yz / sampleInFlow(wrapNx(coord), 1, nxWaterHeight, waterHeight);
    else if (diffNx < 0) nxFlow = diffNx * diffNx * splitFlow;
    if (diffPy > 0)      pyFlow = diffPy * diffPy * py.yz / sampleInFlow(wrapPy(coord), 2, pyWaterHeight, waterHeight);
    else if (diffPy < 0) pyFlow = diffPy * diffPy * splitFlow;
    if (diffNy > 0)      nyFlow = diffNy * diffNy * ny.yz / sampleInFlow(wrapNy(coord), 3, nyWaterHeight, waterHeight);
    else if (diffNy < 0) nyFlow = diffNy * diffNy * splitFlow;
    
    float waterFlow    = (pxFlow.x + nxFlow.x + pyFlow.x + nyFlow.x) / cellSize; // Positive -> flow in | Negative -> flow out
    float sedimentFlow = (pxFlow.y + nxFlow.y + pyFlow.y + nyFlow.y) / cellSize; // Positive -> flow in | Negative -> flow out
    
    float waterSurfaceSlope = length(float2(diffPx - diffNx, diffPy - diffNy)) / doubleCellSize; // Average gradient across point
    float streamPower = 0;
    if(here.y > 0 && waterSurfaceSlope > 0) streamPower = pow(here.y, m) * pow(waterSurfaceSlope, n); // Compiler can handle fixed pow(0,y) but shader can't handle dynamic pow(x,y) where x = 0
    
    float landHeightLaplacian = (px.x + nx.x + py.x + ny.x - 4 * here.x) / cellSize;
    
    float erosion = e * streamPower;
    float creep = c * landHeightLaplacian;
    
    float sedimentation = streamPower > 0 ? min(s * min(here.z, here.z + sedimentFlow) / streamPower, here.z + sedimentFlow) : min(here.z, here.z + sedimentFlow); // Sediment flow can be negative and so we need to avoid possibly creating sediment out of nothing
    
    float dw = r + waterFlow; // Change in water depth with respect to time
    float dh = u + creep - erosion + sedimentation; // Change in bedrock height with respect to time
    float dl = sedimentFlow + erosion - sedimentation; // Change in transported sediment with respect to time

    float3 newState = here + dt * float3(dh, dw, dl);
    
    result[uint3(coord, 0)] = newState.x;
    result[uint3(coord, 1)] = max(0, newState.y); // this max should never actually do anything unless something goes wrong
    result[uint3(coord, 2)] = max(0, newState.z);
}


uint octaves;
float noiseScale;

RWTexture3D<float> genResult;
float width;
float height;
float left;
float bottom;
float4 seed;

[numthreads(8, 8, 1)]
void Generate(uint3 id : SV_DispatchThreadID)
{
    float s = id.x / float(dim.x);
    float t = id.y / float(dim.y);
    
    float nx = seed.x + left + cos(s * 2 * PI) * width / (2 * PI);
    float ny = seed.y + bottom + cos(t * 2 * PI) * height / (2 * PI);
    float nz = seed.z + left + sin(s * 2 * PI) * width / (2 * PI);
    float nw = seed.w + bottom + sin(t * 2 * PI) * height / (2 * PI);
    
    float frequency = 1 / noiseScale;
    float scale = 10;
    
    float sum = 0;
    for (uint i = 0; i < octaves; i++)
    {
        sum += snoise(float4(nx, ny, nz, nw) * frequency) * scale;
        scale *= 0.5;
        frequency *= 2;
    }
    
    genResult[uint3(id.xy, 0)] = sum;
    genResult[uint3(id.xy, 1)] = max(0, -sum);
    genResult[uint3(id.xy, 2)] = 0;
}